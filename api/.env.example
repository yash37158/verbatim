DATABASE_URL=postgresql://localhost:5432/verbatim
GEMINI_API_KEY=

# Verify these against https://ai.google.dev/gemini-api/docs/models before deploying —
# Google's model IDs move, and a stale ID fails at the first call, not at startup.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

STORAGE_DIR=./storage
RUN_WORKER=true
